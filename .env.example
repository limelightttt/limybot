# Bot tokens and cafe settings live in the database (python -m cafe add ...), not here.
DB_PATH=data/limybot.db
# Address the owner's phone opens the web admin at; /admin links in the bot are built from it.
# On a server: https://admin.your-domain.uz (behind nginx/caddy with HTTPS).
PUBLIC_URL=http://localhost:8000
# 127.0.0.1 = only this computer; 0.0.0.0 = reachable from the local network / reverse proxy
WEB_HOST=127.0.0.1
WEB_PORT=8000
