# Bot tokens and cafe settings live in the database (python -m cafe add ...), not here.
DB_PATH=data/limybot.db
# The public https address: admin login links and the Mini App are built from it. Telegram opens the Mini App
# only over https, so locally use a tunnel (README, «Локально»). On a server with docker compose set DOMAIN instead.
PUBLIC_URL=http://localhost:8000
# Server (docker compose): the domain pointing at this server, e.g. admin.limybot.uz; Caddy gets the certificate
DOMAIN=
# 127.0.0.1 = only this computer; 0.0.0.0 = reachable from the local network / reverse proxy
WEB_HOST=127.0.0.1
WEB_PORT=8000
# How cafe owners reach you about the subscription (shown in their admin when it ends), e.g. @limybot_support
SUPPORT=
